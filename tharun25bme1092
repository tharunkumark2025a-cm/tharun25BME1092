<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Home Energy Audit | Tharunkumar 25BME1092</title>
<style>
:root{--g:#1f4d40;--hd:#1f4d40;--a:#c77d2a;--bg:#f4f7f5;--t:#1d2b27;--card:#fff;--soft:#eef5f2;--th:#e6f0ec;--line:#e3e9e6;--mut:#5b6b66;--wb:#fff4e0;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth;color-scheme:light}@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--g:#6fc3a6;--hd:#14352c;--bg:#0f1715;--t:#e4ede9;--card:#18231f;--soft:#1f2d28;--th:#22332d;--line:#2c3d37;--mut:#98aba4;--wb:#3a2d17;color-scheme:dark}}:root[data-theme="dark"]{--g:#6fc3a6;--hd:#14352c;--bg:#0f1715;--t:#e4ede9;--card:#18231f;--soft:#1f2d28;--th:#22332d;--line:#2c3d37;--mut:#98aba4;--wb:#3a2d17;color-scheme:dark}*{box-sizing:border-box}
body{margin:0;font:15px/1.5 system-ui,sans-serif;background:var(--bg);color:var(--t)}
header{background:var(--hd);color:#fff;padding:22px 16px}h1{margin:0;font-size:22px}header p{margin:4px 0 0;opacity:.85;font-size:13px}
main{max-width:980px;margin:auto;padding:10px}nav{display:flex;gap:6px;overflow-x:auto;padding:8px 10px;position:sticky;top:env(safe-area-inset-top,0px);background:var(--bg);z-index:5}nav a{flex:none;font-size:12.5px;padding:4px 10px;border-radius:14px;background:var(--soft);color:var(--g);text-decoration:none}.card{background:var(--soft);border-radius:8px;padding:10px;font-size:13px}.card b{color:var(--g)}footer{font-size:12px;color:var(--mut);padding:10px 14px 24px;text-align:center}section{background:var(--card);border-radius:10px;padding:14px;margin:12px 0;box-shadow:0 1px 3px #0001}
h2{margin:0 0 8px;font-size:17px;color:var(--g)}.n{font-size:12.5px;color:var(--mut)}.warn{background:var(--wb);border-left:4px solid var(--a);padding:8px 10px;font-size:13px;border-radius:6px}
.tw{overflow-x:auto}table{border-collapse:collapse;width:100%;font-size:13px}th,td{padding:5px 6px;border-bottom:1px solid var(--line);text-align:left;white-space:nowrap}th{background:var(--th)}
input[type=number]{width:72px;padding:3px;border:1px solid var(--line);border-radius:5px;background:var(--card);color:var(--t)}
.kpi{display:grid;grid-template-columns:repeat(auto-fit,minmax(125px,1fr));gap:8px}.kpi div{background:var(--soft);border-radius:8px;padding:8px;font-size:12px}.kpi b{display:block;font-size:18px;color:var(--g)}
.bar{display:flex;align-items:center;gap:6px;font-size:12px;margin:3px 0}.bar .l{width:140px;flex:none;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.bar i{display:block;height:13px;background:var(--a);border-radius:3px}
.cols{display:flex;align-items:flex-end;gap:4px;height:120px;margin:6px 0 20px}.cols div{flex:1;background:var(--g);border-radius:3px 3px 0 0;position:relative;min-height:2px}.cols small{position:absolute;bottom:-16px;left:0;right:0;text-align:center;font-size:10px}
.g2{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px}label{display:block;font-size:12.5px;margin:4px 0}.out{background:var(--soft);padding:8px;border-radius:8px;margin-top:6px;font-size:13px}
</style></head><body>
<header><h1>Residential Energy Audit and Conservation Plan</h1><p>Tharunkumar | Reg. No. 25BME1092 | Thermodynamics DA1</p></header>
<nav><a href="#sum">Summary</a><a href="#method">Method</a><a href="#inv">Inventory</a><a href="#bills">Bills</a><a href="#res0">Results</a><a href="#ecm">Measures</a><a href="#thermo">Thermodynamics</a><a href="#obs">Observations</a></nav>
<main>
<section id="sum"><h2>Executive summary</h2><p id="sumtxt"></p><div class="warn">Sample figures are loaded. Every input on this page can be edited and the whole report recalculates instantly.</div></section>
<section id="method"><h2>Method and thermodynamic basis</h2><div class="g2"><div class="card"><b>Audit approach.</b> Preliminary audit in the BEE style: load inventory, bill analysis, kWh/day benchmark, measures ranked by cost and payback, then NPV and CO<sub>2</sub> checks.</div><div class="card"><b>First law.</b> Electrical input equals useful service plus losses. A device that wastes less gives the same service for less input.</div><div class="card"><b>Second law.</b> Electricity is high-grade work. Turning it into low-grade heat (geysers) destroys availability, so those loads get timers and lower setpoints first.</div><div class="card"><b>Heat transfer and COP.</b> Envelope gain is Q = UA&Delta;T and window solar gain is SHGC x A x I. An AC removes Q<sub>L</sub> with work W, COP = Q<sub>L</sub>/W, limited by Carnot.</div></div></section>
<span id="inv"></span>
<section><h2>1. Appliance inventory</h2><p class="n">Existing power, daily hours, proposed power and cost per unit. Tick "Apply" to include the upgrade in the savings.</p><div class="tw"><table id="app"></table></div></section>
<span id="bills"></span><section><h2>2. Monthly electricity bills</h2><div class="tw"><table id="mon"></table></div><p class="n" id="gap"></p></section>
<section id="res0"><h2>3. Audit results (existing condition)</h2><div class="kpi" id="kpi"></div><h2 style="margin-top:14px;font-size:14px">Monthly consumption (kWh)</h2><div class="cols" id="cols"></div><h2 style="font-size:14px">End-use share of annual energy</h2><div id="share"></div></section>
<section id="ecm"><h2>4. Energy conservation measures</h2><p class="n">Percentage measures act on the air-conditioner energy that remains after any hardware upgrade, so savings are not double counted.</p><div class="tw"><table id="pct"></table></div>
<div class="kpi" style="margin:10px 0"><label>CO<sub>2</sub> factor kg/kWh<br><input type="number" step="0.01" data-k="g.0.ef"></label><label>Discount rate %<br><input type="number" data-k="g.0.r"></label><label>Project life (yr)<br><input type="number" data-k="g.0.y"></label></div>
<div class="kpi" id="res"></div></section>
<section id="thermo"><h2>5. Thermodynamic tools</h2><div class="g2">
<div><b>Window solar gain (Q = SHGC x A x I)</b><label>Area m&sup2; <input type="number" id="wa" value="1.5" step="0.1"></label><label>Irradiance W/m&sup2; <input type="number" id="wi" value="600"></label><label>SHGC before / after <input type="number" id="w0" value="0.86" step="0.01"> <input type="number" id="w1" value="0.45" step="0.01"></label><label>AC COP <input type="number" id="wc" value="3" step="0.1"></label><label>Hours/day x days/yr <input type="number" id="wh" value="4"> <input type="number" id="wd" value="200"></label><div class="out" id="wo"></div></div>
<div><b>AC setpoint (Carnot-based estimate)</b><label>Outdoor &deg;C <input type="number" id="ao" value="35"></label><label>Setpoint now / new &deg;C <input type="number" id="a0" value="22"> <input type="number" id="a1" value="25"></label><p class="n">Model: evaporator = setpoint - 10 K, condenser = outdoor + 15 K, W &prop; 1/COP.</p><div class="out" id="ao2"></div></div></div></section>
<section id="obs"><h2>6. Observations and recommendations by area</h2><div class="g2">
<div class="card"><b>Lighting.</b> Replace T8 tubes and CFLs with LED. Check lux levels and use task lighting.</div>
<div class="card"><b>Fans.</b> BLDC fans deliver the same airflow at about 28 W instead of 75 W. Switch off in empty rooms.</div>
<div class="card"><b>Water pumping.</b> Use a float switch or timer, fix foot-valve leaks and avoid throttling. P = &rho;gQH/&eta;.</div>
<div class="card"><b>Air conditioning.</b> Set 24&ndash;26&nbsp;&deg;C, clean filters monthly, shade the outdoor unit and buy a 5-star inverter model at replacement.</div>
<div class="card"><b>Windows and envelope.</b> Shade west and south glass, apply reflective film, seal gaps, and consider cool-roof paint.</div>
<div class="card"><b>Ventilation.</b> Cross-ventilate in the evening, vent kitchen and bath fans outdoors, and use fans to allow a higher AC setpoint.</div></div></section>
<section><h2>7. Basis</h2><p class="n">Method follows the BEE preliminary-audit approach: inventory, bill analysis, benchmarking (kWh/day), measures ranked by payback, then economic check by simple payback and NPV. Energy performance after implementation: PEP = (reference-year equivalent - current use) / reference-year equivalent x 100.</p></section>
</main><footer>Energy Audit Report | Tharunkumar, 25BME1092 | References: BEE Energy Management and Audit (Chapter 3), Energy Management Centre Kerala audit manual, City of Seattle DIY Home Energy Audit.</footer>
<script>
const D={"app": [{"n": "Tube light T8 + choke", "q": 6, "w": 50, "h": 6, "nw": 18, "c": 350, "on": true}, {"n": "CFL lamp", "q": 5, "w": 15, "h": 5, "nw": 9, "c": 120, "on": true}, {"n": "Ceiling fan", "q": 5, "w": 75, "h": 10, "nw": 28, "c": 3200, "on": true}, {"n": "Refrigerator 250 L", "q": 1, "w": 67, "h": 24, "nw": 67, "c": 0, "on": false}, {"n": "Water pump 0.5 HP", "q": 1, "w": 600, "h": 1.5, "nw": 520, "c": 1200, "on": true}, {"n": "Geyser 2 kW", "q": 1, "w": 2000, "h": 0.5, "nw": 1500, "c": 800, "on": true}, {"n": "Television", "q": 1, "w": 100, "h": 4, "nw": 60, "c": 0, "on": true}, {"n": "Washing machine", "q": 1, "w": 500, "h": 0.7, "nw": 500, "c": 0, "on": false}, {"n": "Mixer / grinder", "q": 1, "w": 500, "h": 0.3, "nw": 500, "c": 0, "on": false}, {"n": "Laptop, chargers, WiFi", "q": 1, "w": 70, "h": 8, "nw": 50, "c": 1500, "on": true}, {"n": "Split AC 1.5 ton", "q": 1, "w": 1600, "h": 4.01, "nw": 1050, "c": 42000, "on": true, "ac": true}], "m": [{"m": "Jan", "u": 387, "b": 2324}, {"m": "Feb", "u": 395, "b": 2368}, {"m": "Mar", "u": 586, "b": 3514}, {"m": "Apr", "u": 711, "b": 4265}, {"m": "May", "u": 784, "b": 4704}, {"m": "Jun", "u": 615, "b": 3689}, {"m": "Jul", "u": 536, "b": 3216}, {"m": "Aug", "u": 536, "b": 3216}, {"m": "Sep", "u": 519, "b": 3113}, {"m": "Oct", "u": 486, "b": 2919}, {"m": "Nov", "u": 375, "b": 2249}, {"m": "Dec", "u": 387, "b": 2324}], "pct": [{"n": "Raise AC setpoint to 24-26 C", "p": 8, "c": 0, "on": true}, {"n": "Window film, shading, sealing", "p": 10, "c": 4000, "on": true}], "g": [{"ef": 0.82, "r": 8, "y": 10}]};const $=s=>document.querySelector(s);const f=(n,d=0)=>Number(n).toLocaleString('en-IN',{maximumFractionDigits:d});
const inp=(k,v,st)=>`<input type="number" step="${st||'any'}" value="${v}" data-k="${k}">`;
function build(){
$('#app').innerHTML='<tr><th>Appliance</th><th>Qty</th><th>W</th><th>h/day</th><th>kWh/yr</th><th>New W</th><th>Rs/unit</th><th>Apply</th></tr>'+D.app.map((a,i)=>`<tr><td>${a.n}</td><td>${inp('app.'+i+'.q',a.q)}</td><td>${inp('app.'+i+'.w',a.w)}</td><td>${inp('app.'+i+'.h',a.h)}</td><td id="k${i}"></td><td>${inp('app.'+i+'.nw',a.nw)}</td><td>${inp('app.'+i+'.c',a.c)}</td><td><input type="checkbox" data-k="app.${i}.on" ${a.on?'checked':''}></td></tr>`).join('');
$('#mon').innerHTML='<tr><th>Month</th><th>Units kWh</th><th>Bill Rs</th></tr>'+D.m.map((a,i)=>`<tr><td>${a.m}</td><td>${inp('m.'+i+'.u',a.u)}</td><td>${inp('m.'+i+'.b',a.b)}</td></tr>`).join('');
$('#pct').innerHTML='<tr><th>Measure (on AC energy)</th><th>Saving %</th><th>Cost Rs</th><th>Apply</th></tr>'+D.pct.map((a,i)=>`<tr><td>${a.n}</td><td>${inp('pct.'+i+'.p',a.p)}</td><td>${inp('pct.'+i+'.c',a.c)}</td><td><input type="checkbox" data-k="pct.${i}.on" ${a.on?'checked':''}></td></tr>`).join('');
document.querySelectorAll('[data-k^="g."]').forEach(e=>e.value=D.g[0][e.dataset.k.split('.')[2]]);}
function update(){
const sU=D.m.reduce((s,x)=>s+x.u,0),sB=D.m.reduce((s,x)=>s+x.b,0),tar=sB/sU;
const ex=D.app.map(a=>a.q*a.w*a.h*365/1000),model=ex.reduce((s,x)=>s+x,0);
ex.forEach((v,i)=>$('#k'+i).textContent=f(v));
$('#gap').textContent=`Appliance model: ${f(model)} kWh/yr vs billed ${f(sU)} kWh/yr (${f((model-sU)/sU*100,1)}% gap). Adjust hours until the gap is small.`;
$('#kpi').innerHTML=[['Annual units',f(sU)+' kWh'],['Annual bill','Rs '+f(sB)],['Avg tariff','Rs '+f(tar,2)+'/kWh'],['Per day',f(sU/365,1)+' kWh'],['Per person*',f(sU/4)+' kWh/yr'],['CO2',f(sU*D.g[0].ef/1000,2)+' t/yr']].map(x=>`<div>${x[0]}<b>${x[1]}</b></div>`).join('');
const mx=Math.max(...D.m.map(x=>x.u));$('#cols').innerHTML=D.m.map(x=>`<div style="height:${x.u/mx*100}%" title="${x.u}"><small>${x.m}</small></div>`).join('');
const o=D.app.map((a,i)=>[a.n,ex[i]]).sort((a,b)=>b[1]-a[1]),m2=o[0][1];
$('#share').innerHTML=o.map(x=>`<div class="bar"><span class="l">${x[0]}</span><i style="width:${x[1]/m2*55}%"></i>${f(x[1]/model*100)}%</div>`).join('');
let sk=0,inv=0;D.app.forEach((a,i)=>{if(a.on&&a.nw<a.w){sk+=ex[i]-a.q*a.nw*a.h*365/1000;inv+=a.c*a.q}});
const ai=D.app.findIndex(a=>a.ac);let ac=ai>=0&&D.app[ai].on?D.app[ai].q*D.app[ai].nw*D.app[ai].h*365/1000:(ai>=0?ex[ai]:0);
D.pct.forEach(p=>{if(p.on){sk+=ac*p.p/100;ac*=1-p.p/100;inv+=p.c}});
const r=D.g[0].r/100,y=D.g[0].y,af=(1-Math.pow(1+r,-y))/r,sr=sk*tar,npv=sr*af-inv;
$('#res').innerHTML=[['Energy saved',f(sk)+' kWh/yr ('+f(sk/model*100)+'%)'],['Money saved','Rs '+f(sr)+'/yr'],['Investment','Rs '+f(inv)],['Simple payback',sr>0?f(inv/sr,1)+' yr':'-'],['NPV','Rs '+f(npv)],['CO2 avoided',f(sk*D.g[0].ef)+' kg/yr']].map(x=>`<div>${x[0]}<b>${x[1]}</b></div>`).join('');
$('#sumtxt').innerHTML=`The home uses about ${f(sU)} kWh a year (${f(sU/365,1)} kWh/day) at a cost of Rs ${f(sB)}. The selected measures save ${f(sk)} kWh (${f(sk/model*100)}%) and Rs ${f(sr)} a year, avoid ${f(sk*D.g[0].ef/1000,1)} t of CO<sub>2</sub>, cost Rs ${f(inv)} and pay back in ${sr>0?f(inv/sr,1):'-'} years with a ten-year NPV of Rs ${f(npv)}.`;
const g=id=>+$('#'+id).value,dq=(g('w0')-g('w1'))*g('wa')*g('wi'),ke=dq/g('wc')*g('wh')*g('wd')/1000;
$('#wo').innerHTML=`Cooling load cut: ${f(dq)} W<br>Electrical saving: ${f(dq/g('wc'))} W, about ${f(ke,1)} kWh/yr (Rs ${f(ke*tar)})`;
const cop=s=>(s-10+273.15)/(g('ao')+15-(s-10)),s0=cop(g('a0')),s1=cop(g('a1'));
$('#ao2').innerHTML=`COP ${f(s0,2)} to ${f(s1,2)}<br>Compressor work saved: ${f((1-s0/s1)*100,1)}% (${f((1-s0/s1)*100/Math.abs(g('a1')-g('a0')||1),1)}% per &deg;C)`;}
document.addEventListener('input',e=>{const k=e.target.dataset.k;if(k){const[a,i,c]=k.split('.');D[a][i][c]=e.target.type=='checkbox'?e.target.checked:+e.target.value;}update();try{localStorage.setItem('ea25',JSON.stringify(D))}catch(x){}});
try{const s=localStorage.getItem("ea25");if(s){const o=JSON.parse(s);if(o.app&&o.app.length==D.app.length)Object.assign(D,o)}}catch(e){}
build();update();
</script></body></html>
